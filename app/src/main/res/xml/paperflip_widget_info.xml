<?xml version="1.0" encoding="utf-8"?>
<!--
    Home-screen widget metadata — the Android counterpart of the iOS
    widget's `supportedFamilies([.systemSmall, .systemMedium])`.

    targetCellWidth/Height give the launcher a 2x2 default (the iOS
    "small" family); resizeMode lets the user stretch it to the 4x2
    "medium" layout, which PaperflipWidget renders responsively.
-->
<appwidget-provider xmlns:android="http://schemas.android.com/apk/res/android"
    android:minWidth="150dp"
    android:minHeight="110dp"
    android:minResizeWidth="140dp"
    android:minResizeHeight="110dp"
    android:targetCellWidth="2"
    android:targetCellHeight="2"
    android:maxResizeWidth="320dp"
    android:maxResizeHeight="160dp"
    android:updatePeriodMillis="3600000"
    android:initialLayout="@layout/glance_default_loading_layout"
    android:previewImage="@mipmap/ic_launcher"
    android:description="@string/widget_description"
    android:resizeMode="horizontal|vertical"
    android:widgetCategory="home_screen" />
